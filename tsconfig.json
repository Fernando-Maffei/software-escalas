{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "backend/**/*.js",
        "scripts/**/*.js",
        "tests/unit/**/*.js",
        "tests/integracao/**/*.js",
        "tests/smoke.js"
    ]
}
