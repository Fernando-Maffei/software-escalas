# Exemplo de configuracao para o Docker.
# Copie este arquivo para .env (o docker compose le .env automaticamente) e
# TROQUE as senhas abaixo. O .env nunca vai para o Git (ja esta no .gitignore).
#
#   Windows PowerShell:  Copy-Item .env.docker.example .env
#   Git Bash:            cp .env.docker.example .env

# Senha do usuario 'sa' do SQL Server dentro do container.
# Regra do SQL Server: no minimo 8 caracteres, com maiuscula, minuscula,
# numero e simbolo — senao o banco nem sobe.
DB_PASSWORD=Escalas!Forte2026

# Senha do administrador do app (usada no primeiro login).
# Se deixar vazio, o app gera uma senha aleatoria e mostra no log do
# container (docker compose logs app).
ADMIN_PASSWORD=TroqueEstaSenha!2026
