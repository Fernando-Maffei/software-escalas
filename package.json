{
  "name": "app-de-escalas",
  "version": "1.6.3",
  "description": "Sistema web para gestao de escalas de trabalho.",
  "productName": "App de Escalas",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "node tests/unit/run-tests.js",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --project=demo",
    "e2e:teste": "playwright test --project=teste",
    "e2e:relatorio": "playwright show-report tests/e2e/relatorio",
    "teste:subir": "docker compose -f docker-compose.teste.yml up -d --build",
    "teste:derrubar": "docker compose -f docker-compose.teste.yml down -v",
    "limpar-feriados-nacionais": "node scripts/limpar-feriados-nacionais.js",
    "smoke": "node tests/smoke.js"
  },
  "keywords": [],
  "author": "Fernando Maffei",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mssql": "^12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
