# Configuracao do servidor rodando direto na maquina (sem Docker).
# Copie para .env, na raiz do projeto; o servidor le o arquivo ao iniciar
# (npm start ou servico do Windows). Variavel ja definida no ambiente vence a
# do arquivo. O .env nunca vai para o Git.
PORT=4450

# Conexao com o SQL Server. OPCIONAL: o normal e deixar tudo em branco e
# informar a conexao pela tela "Configuracao inicial" do app, que grava
# backend/config/database.local.json — e esse arquivo, quando existe, vence o
# que estiver aqui.
# Com porta fixa (recomendado, ver scripts/preparar-sql-server.ps1):
#   DB_SERVER=localhost  e  DB_PORT=1433
# Com instancia nomeada (depende do servico SQL Server Browser), uma barra so:
#   DB_SERVER=localhost\SQLEXPRESS
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Usuario administrador criado automaticamente na primeira execucao,
# se a tabela Usuarios ainda estiver vazia.
# Se ADMIN_PASSWORD nao for definida (ou tiver menos de 8 caracteres), uma
# senha aleatoria e gerada e impressa uma unica vez no console do servidor,
# com troca obrigatoria no primeiro login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Lista de origens (separadas por virgula) autorizadas a fazer
# requisicoes cross-site para a API. Deixe vazio para aceitar apenas
# requisicoes de mesma origem (uso normal do sistema).
CORS_ORIGINS=

# Proxy reverso na frente do app (nginx, IIS, Caddy)? So entao informe em
# quem confiar, e o IP real do cliente passa a vir do X-Forwarded-For (usado
# no limite de tentativas de login). Vazio = nao confia em proxy nenhum.
# Aceita: numero de saltos (1), enderecos/sub-redes (loopback, 10.0.0.0/8)
# ou true (qualquer um — so se a porta do app nao for acessivel direto).
TRUST_PROXY=
