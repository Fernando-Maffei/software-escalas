PORT=3000
DB_USER=admin
DB_PASSWORD=
DB_SERVER=localhost\\SQLEXPRESS
DB_DATABASE=SoftwareEscalas
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Usuario administrador criado automaticamente na primeira execucao,
# se a tabela Usuarios ainda estiver vazia.
# Se ADMIN_PASSWORD nao for definida, uma senha aleatoria e gerada e
# impressa uma unica vez no console do servidor, com troca obrigatoria
# no primeiro login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Lista de origens (separadas por virgula) autorizadas a fazer
# requisicoes cross-site para a API. Deixe vazio para aceitar apenas
# requisicoes de mesma origem (uso normal do sistema).
CORS_ORIGINS=
